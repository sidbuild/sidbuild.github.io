        </p>
    </div>


    <div class="feature">
        <div class="feature-icon">▥</div>
        <h3>EXTERIOR CLADDING</h3>
        <p>
            Professional installation
            and detailing.
        </p>
    </div>


    <div class="feature">
        <div class="feature-icon">✓</div>
        <h3>QUALITY FIRST</h3>
        <p>
            Attention to detail
            in every project.
        </p>
    </div>

</section>



<!-- ================= ABOUT ================= -->

<section class="section section-dark" id="about">

    <div class="about">

